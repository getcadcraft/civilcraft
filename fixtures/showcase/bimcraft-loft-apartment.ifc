#789=IFCPROPERTYSINGLEVALUE('Recipe',$,IFCTEXT('{"format":"cadcraft-family","version":1,"key":"win-fixed","name":"Fixed window","kind":"window","host":"wall","base":"win-fixed","ifc":{"class":"IfcWindow"},"params":[{"key":"Width","kind":"length","value":1219.1999999999998},{"key":"Height","kind":"length","value":1219.1999999999998},{"key":"Frame","kind":"length","value":0,"formula":"min(50.8, (Width / 6), (Height / 6))"},{"key":"Depth","kind":"length","value":0,"formula":"min(114.3, WallThickness)"},{"key":"Y0","kind":"length","value":0,"formula":"if((Face > 0), ((WallThickness / 2) - Depth), ((-WallThickness) / 2))"},{"key":"Y1","kind":"length","value":0,"formula":"(Y0 + Depth)"},{"key":"GlassY","kind":"length","value":0,"formula":"((Y0 + Y1) / 2)"}],"solids":[{"id":"s1","op":"box","x0":"0","y0":"Y0","z0":"0","x1":"Frame","y1":"Y1","z1":"Height","style":"frame"},{"id":"s2","op":"box","x0":"(Width - Frame)","y0":"Y0","z0":"0","x1":"Width","y1":"Y1","z1":"Height","style":"frame"},{"id":"s3","op":"box","x0":"Frame","y0":"Y0","z0":"0","x1":"(Width - Frame)","y1":"Y1","z1":"Frame","style":"frame"},{"id":"s4","op":"box","x0":"Frame","y0":"Y0","z0":"(Height - Frame)","x1":"(Width - Frame)","y1":"Y1","z1":"Height","style":"frame"},{"id":"s5","op":"box","x0":"Frame","y0":"(GlassY - 3)","z0":"Frame","x1":"(Width - Frame)","y1":"(GlassY + 3)","z1":"(Height - Frame)","style":"glass"}],"booleans":[],"starter":true}'),$);
