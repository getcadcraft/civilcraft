#8543=IFCPROPERTYSINGLEVALUE('Recipe',$,IFCTEXT('{"format":"cadcraft-family","version":1,"key":"fam-shelf","name":"Shelf unit","kind":"furniture","host":"none","base":"","ifc":{"class":"IfcFurniture","predefined":"SHELF"},"params":[{"key":"Width","kind":"length","value":900},{"key":"Depth","kind":"length","value":350},{"key":"Height","kind":"length","value":1800},{"key":"Board","kind":"length","value":18},{"key":"Shelves","kind":"number","value":4},{"key":"Back","kind":"yesno","value":1},{"key":"Gap","kind":"length","value":0,"formula":"((Height - 2 * Board) / Shelves)"}],"solids":[{"id":"s1","name":"Side","op":"box","x0":"(-Width / 2)","y0":"0","z0":"0","x1":"(-Width / 2 + Board)","y1":"Depth","z1":"Height","style":"wood"},{"id":"s2","name":"Side","op":"box","x0":"(Width / 2 - Board)","y0":"0","z0":"0","x1":"(Width / 2)","y1":"Depth","z1":"Height","style":"wood"},{"id":"s3","name":"Bottom","op":"box","x0":"(-Width / 2 + Board)","y0":"0","z0":"0","x1":"(Width / 2 - Board)","y1":"Depth","z1":"Board","style":"wood"},{"id":"s4","name":"Top","op":"box","x0":"(-Width / 2 + Board)","y0":"0","z0":"(Height - Board)","x1":"(Width / 2 - Board)","y1":"Depth","z1":"Height","style":"wood"},{"id":"s5","name":"Shelf","op":"box","x0":"(-Width / 2 + Board)","y0":"0","z0":"(Board + Gap)","x1":"(Width / 2 - Board)","y1":"Depth","z1":"(2 * Board + Gap)","style":"wood","visible":"(Shelves >= 2)"},{"id":"s6","name":"Shelf","op":"box","x0":"(-Width / 2 + Board)","y0":"0","z0":"(Board + 2 * Gap)","x1":"(Width / 2 - Board)","y1":"Depth","z1":"(2 * Board + 2 * Gap)","style":"wood","visible":"(Shelves >= 3)"},{"id":"s7","name":"Shelf","op":"box","x0":"(-Width / 2 + Board)","y0":"0","z0":"(Board + 3 * Gap)","x1":"(Width / 2 - Board)","y1":"Depth","z1":"(2 * Board + 3 * Gap)","style":"wood","visible":"(Shelves >= 4)"},{"id":"s8","name":"Back","op":"box","x0":"(-Width / 2)","y0":"(Depth - 6)","z0":"0","x1":"(Width / 2)","y1":"Depth","z1":"Height","style":"wood","visible":"Back"}],"booleans":[],"