{
  "app": "civilcraft",
  "css": [
    "civilcraft.css",
    "landscape/landscape.css",
    "powerline/powerline.css"
  ],
  "module": "civilcraft.js",
  "imports": {
    "delaunator": "/assets/vendor/delaunator/current/index.js",
    "robust-predicates": "/assets/vendor/robust-predicates/current/index.js",
    "three": "/assets/vendor/three/current/three.module.js",
    "proj4": "/assets/vendor/proj4/current/proj4.esm.min.js",
    "geotiff": "/assets/vendor/geotiff/current/geotiff.esm.min.js",
    "laz-perf": "/assets/vendor/laz-perf/current/laz-perf.js",
    "sql.js": "/assets/vendor/sql.js/current/sql-wasm.esm.js",
    "@noble/curves/": "/assets/vendor/noble-curves/current/",
    "@noble/hashes/": "/assets/vendor/noble-hashes/current/",
    "@noble/ciphers/": "/assets/vendor/noble-ciphers/current/"
  },
  "phone": { "hint": "[data-toolhint]" },
  "panels": [
    "move",
    "window"
  ],
  "accepts": [
    "live"
  ],
  "input": "input-civilcraft.js",
  "workspaces": {
    "layouts": [
      "docked",
      "toolbox"
    ],
    "adapter": "workspace-civilcraft.js"
  },
  "hardware": true
}
