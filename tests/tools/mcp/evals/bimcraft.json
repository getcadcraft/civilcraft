[
 {
  "id": "describe-model",
  "title": "Describe the house",
  "prompt": "What levels, walls, doors and windows does the house have?",
  "fixtures": {
   "house.ifc": "fixtures/showcase/bimcraft-house.ifc"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "ifc_open",
    "args": {
     "path": "house.ifc"
    },
    "as": "o"
   },
   {
    "tool": "model_describe",
    "args": {
     "doc": "$o.doc"
    }
   }
  ],
  "check": [
   {
    "file": "house.ifc",
    "kind": "ifc",
    "path": "classes.IFCWALL",
    "eq": 13
   },
   {
    "file": "house.ifc",
    "kind": "ifc",
    "path": "classes.IFCDOOR",
    "eq": 7
   }
  ]
 },
 {
  "id": "query-doors",
  "title": "List the doors",
  "prompt": "List every door in the house.",
  "fixtures": {
   "house.ifc": "fixtures/showcase/bimcraft-house.ifc"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "ifc_open",
    "args": {
     "path": "house.ifc"
    },
    "as": "o"
   },
   {
    "tool": "ifc_query",
    "args": {
     "doc": "$o.doc",
     "class": "IfcDoor",
     "limit": 50
    },
    "as": "q"
   }
  ],
  "check": [
   {
    "file": "house.ifc",
    "kind": "ifc",
    "path": "classes.IFCDOOR",
    "eq": 7
   },
   {
    "file": "house.ifc",
    "kind": "ifc",
    "path": "classes.IFCWINDOW",
    "eq": 9
   }
  ]
 },
 {
  "id": "door-properties",
  "title": "Read a door's properties",
  "prompt": "Show the properties of the first door.",
  "fixtures": {
   "house.ifc": "fixtures/showcase/bimcraft-house.ifc"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "ifc_open",
    "args": {
     "path": "house.ifc"
    },
    "as": "o"
   },
   {
    "tool": "ifc_query",
    "args": {
     "doc": "$o.doc",
     "class": "IfcDoor",
     "limit": 1
    },
    "as": "q"
   },
   {
    "tool": "ifc_properties",
    "args": {
     "doc": "$o.doc",
     "id": "$q.elements.0.id"
    }
   }
  ],
  "check": [
   {
    "file": "house.ifc",
    "kind": "ifc",
    "path": "classes.IFCSPACE",
    "eq": 5
   }
  ]
 },
 {
  "id": "walls-by-level",
  "title": "List walls on Level 1",
  "prompt": "List the walls of Level 1 with their openings.",
  "fixtures": {
   "house.ifc": "fixtures/showcase/bimcraft-house.ifc"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "ifc_open",
    "args": {
     "path": "house.ifc"
    },
    "as": "o"
   },
   {
    "tool": "walls_list",
    "args": {
     "doc": "$o.doc",
     "level": "Level 1"
    }
   }
  ],
  "check": [
   {
    "file": "house.ifc",
    "kind": "ifc",
    "path": "classes.IFCWALL",
    "gte": 13
   }
  ]
 },
 {
  "id": "draw-room",
  "title": "Draw a closed room of walls",
  "prompt": "Make a new model with a 6 x 4 m room and save it.",
  "fixtures": {},
  "allow": [
   "read",
   "edit",
   "save"
  ],
  "steps": [
   {
    "tool": "ifc_new",
    "args": {},
    "as": "n"
   },
   {
    "tool": "walls_add",
    "args": {
     "doc": "$n.doc",
     "points": [
      [
       0,
       0
      ],
      [
       6000,
       0
      ],
      [
       6000,
       4000
      ],
      [
       0,
       4000
      ]
     ],
     "closed": true
    },
    "as": "w"
   },
   {
    "tool": "ifc_save",
    "args": {
     "doc": "$n.doc",
     "path": "room.ifc"
    }
   }
  ],
  "check": [
   {
    "file": "room.ifc",
    "kind": "ifc",
    "path": "classes.IFCWALL",
    "eq": 4
   },
   {
    "file": "room.ifc",
    "kind": "ifc",
    "path": "header",
    "includes": "ISO-10303-21"
   }
  ]
 },
