   },
   {
    "tool": "drawing_save",
    "args": {
     "doc": "$n.doc",
     "path": "s.dxf",
     "format": "dxf2000"
    }
   }
  ],
  "check": [
   {
    "file": "s.dxf",
    "kind": "cad",
    "path": "objects",
    "eq": 2
   }
  ]
 },
