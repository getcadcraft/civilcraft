[
 {
  "id": "count-by-layer",
  "title": "Count objects by layer (the test prompt)",
  "prompt": "Open the kitchen drawing and tell me how many objects it has, by layer.",
  "fixtures": {
   "Kitchen/k.dwg": "fixtures/dwg/kitchen-equipment.dwg"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "drawing_open",
    "args": {
     "path": "Kitchen/k.dwg"
    },
    "as": "o"
   },
   {
    "tool": "drawing_describe",
    "args": {
     "doc": "$o.doc"
    },
    "as": "d"
   }
  ],
  "check": [
   {
    "file": "Kitchen/k.dwg",
    "kind": "cad",
    "path": "objects",
    "eq": 254
   },
   {
    "file": "Kitchen/k.dwg",
    "kind": "cad",
    "path": "layers[name=A-WALL].objects",
    "eq": 4
   }
  ]
 },
 {
  "id": "list-walls",
  "title": "List the wall objects",
  "prompt": "List the objects on layer A-WALL.",
  "fixtures": {
   "Kitchen/k.dwg": "fixtures/dwg/kitchen-equipment.dwg"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "drawing_open",
    "args": {
     "path": "Kitchen/k.dwg"
    },
    "as": "o"
   },
   {
    "tool": "objects_list",
    "args": {
     "doc": "$o.doc",
     "layer": "A-WALL"
    },
    "as": "l"
   }
  ],
  "check": [
