 {
  "id": "plot-sheets",
  "title": "Plot a sheet to PDF",
  "prompt": "Plot the first layout to a PDF.",
  "fixtures": {
   "Kitchen/k.dwg": "fixtures/dwg/kitchen-equipment.dwg"
  },
  "allow": [
   "read",
   "export"
  ],
  "steps": [
   {
    "tool": "drawing_open",
    "args": {
     "path": "Kitchen/k.dwg"
    },
    "as": "o"
   },
   {
    "tool": "drawing_describe",
    "args": {
     "doc": "$o.doc"
    },
    "as": "d"
   },
   {
    "tool": "drawing_plot",
    "args": {
     "doc": "$o.doc",
     "layout": "$d.layouts.0.name",
     "out": "Plots/sheet.pdf"
    }
   }
  ],
  "check": [
   {
    "file": "Plots/sheet.pdf",
    "kind": "pdf",
    "path": "head",
    "matches": "^%PDF"
   },
   {
    "file": "Plots/sheet.pdf",
    "kind": "pdf",
    "path": "pages",
    "gte": 1
   }
  ],
  "folders": [
   "Plots"
  ]
 },
 {
  "id": "check-standards",
  "title": "Check the drawing against office rules",
  "prompt": "Check the drawing: nothing on layer 0, colour by layer.",
  "fixtures": {
   "Kitchen/k.dwg": "fixtures/dwg/kitchen-equipment.dwg"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "drawing_open",
    "args": {
     "path": "Kitchen/k.dwg"
    },
    "as": "o"
   },
   {
    "tool": "drawing_check",
    "args": {
     "doc": "$o.doc",
     "rules": {
      "layers": {
       "noObjectsOn": [
        "0"
       ]
      }
     }
    },
    "as": "c"
   }
  ],
  "check": [
   {
    "file": "Kitchen/k.dwg",
    "kind": "cad",
    "path": "layers[name=0].objects",
    "gte": 1
   }
  ]
 },
 {
  "id": "script-lines",
  "title": "Run a script",
  "prompt": "Draw ten lines with a script.",
  "fixtures": {},
  "allow": [
   "read",
   "edit",
   "save"
  ],
  "steps": [
   {
    "tool": "drawing_new",
    "args": {},
    "as": "n"
   },
   {
    "tool": "script_run",
    "args": {
     "doc": "$n.doc",
     "language": "scr",
     "script": "LINE 0,0 10,0 \n"
    }
   },
   {
    "tool": "command_run",
    "args": {
     "doc": "$n.doc",
     "input": [
      "LINE",
