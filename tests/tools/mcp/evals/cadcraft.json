   }
  ]
 },
 {
  "id": "draw-rectangle",
  "title": "Draw a rectangle",
  "prompt": "Make a new drawing with a 4000 x 3000 rectangle and save it.",
  "fixtures": {},
  "allow": [
   "read",
   "edit",
   "save"
  ],
  "steps": [
   {
    "tool": "drawing_new",
    "args": {
     "name": "Room"
    },
    "as": "n"
   },
   {
    "tool": "command_run",
    "args": {
     "doc": "$n.doc",
     "input": [
      "RECTANG",
      "0,0",
      "4000,3000"
     ]
    },
    "as": "r"
   },
   {
    "tool": "drawing_save",
    "args": {
     "doc": "$n.doc",
     "path": "room.dwg"
    }
   }
  ],
  "check": [
   {
    "file": "room.dwg",
    "kind": "bytes",
    "path": "head",
    "matches": "^AC10"
   },
   {
    "file": "room.dwg",
    "kind": "cad",
    "path": "byType.poly",
    "eq": 1
   },
   {
    "file": "room.dwg",
    "kind": "cad",
    "path": "objects",
    "eq": 1
   }
  ]
 },
 {
  "id": "circle-and-undo",
  "title": "One undo step per call",
  "prompt": "Draw a circle, then undo it.",
  "fixtures": {},
  "allow": [
   "read",
   "edit",
   "save"
  ],
  "steps": [
   {
    "tool": "drawing_new",
    "args": {},
    "as": "n"
   },
   {
    "tool": "command_run",
    "args": {
     "doc": "$n.doc",
     "input": [
      "CIRCLE",
      "0,0",
      "5"
     ]
    },
    "as": "c"
   },
   {
    "tool": "undo",
    "args": {
     "doc": "$n.doc"
    }
   },
   {
    "tool": "drawing_save",
    "args": {
     "doc": "$n.doc",
     "path": "u.dxf",
     "format": "dxf2000"
    }
   }
  ],
  "check": [
   {
    "file": "u.dxf",
    "kind": "cad",
    "path": "objects",
    "eq": 0
   }
  ]
 },
 {
  "id": "purge-unused",
  "title": "Purge unused blocks",
  "prompt": "Purge the unused blocks and save a tidy copy.",
  "fixtures": {
   "Kitchen/k.dwg": "fixtures/dwg/kitchen-equipment.dwg"
  },
  "allow": [
   "read",
   "edit",
   "save"
  ],
  "steps": [
   {
    "tool": "drawing_open",
    "args": {
     "path": "Kitchen/k.dwg"
    },
    "as": "o"
   },
   {
    "tool": "drawing_describe",
    "args": {
     "doc": "$o.doc"
    },
    "as": "d0"
   },
   {
    "tool": "command_run",
    "args": {
     "doc": "$o.doc",
     "input": "PURGE"
    }
   },
   {
    "tool": "drawing_save",
    "args": {
     "doc": "$o.doc",
     "path": "Kitchen/tidy.dwg"
    }
   }
  ],
  "check": [
   {
    "file": "Kitchen/tidy.dwg",
    "kind": "cad",
    "path": "blocks.length",
    "lte": 163
   },
   {
    "file": "Kitchen/tidy.dwg",
    "kind": "cad",
    "path": "layers[name=K-EQPM].objects",
    "eq": 122
   }
  ]
 },
 {
