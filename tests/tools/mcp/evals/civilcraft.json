[
 {
  "id": "describe-site",
  "title": "Describe the site",
  "prompt": "Open the site and tell me how many survey points, which alignments and parcels it has.",
  "fixtures": {
   "site.civilcraft.json": "tools/mcp/evals/fixtures/site.civilcraft.json"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "site_open",
    "args": {
     "path": "site.civilcraft.json"
    },
    "as": "s"
   },
   {
    "tool": "site_describe",
    "args": {
     "doc": "$s.doc"
    }
   }
  ],
  "check": [
   {
    "file": "site.civilcraft.json",
    "kind": "json",
    "path": "points.length",
    "eq": 276
   },
   {
    "file": "site.civilcraft.json",
    "kind": "json",
    "path": "alignments.length",
    "eq": 1
   }
  ]
 },
 {
  "id": "elevation-at-point",
  "title": "Ground elevation at a point",
  "prompt": "What is the ground elevation at 6150200, 2080100?",
  "fixtures": {
   "site.civilcraft.json": "tools/mcp/evals/fixtures/site.civilcraft.json"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "site_open",
    "args": {
     "path": "site.civilcraft.json"
    },
    "as": "s"
   },
   {
    "tool": "surface_elevation",
    "args": {
     "doc": "$s.doc",
     "points": [
      {
       "x": 6150200,
       "y": 2080100
      }
     ]
    },
    "as": "e"
   }
  ],
  "check": [
   {
    "file": "site.civilcraft.json",
    "kind": "json",
    "path": "points.length",
    "eq": 276
   }
  ]
 },
 {
  "id": "points-by-group",
  "title": "List survey points of one group",
  "prompt": "List the control points (group CP).",
  "fixtures": {
   "site.civilcraft.json": "tools/mcp/evals/fixtures/site.civilcraft.json"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "site_open",
    "args": {
     "path": "site.civilcraft.json"
    },
    "as": "s"
   },
   {
    "tool": "points_list",
    "args": {
