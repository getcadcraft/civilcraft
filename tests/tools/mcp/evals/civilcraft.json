 {
  "id": "station-and-profile",
  "title": "Stations and profile along the street",
  "prompt": "Give the ground elevation every 100 ft along Main street.",
  "fixtures": {
   "site.civilcraft.json": "tools/mcp/evals/fixtures/site.civilcraft.json"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "site_open",
    "args": {
     "path": "site.civilcraft.json"
    },
    "as": "s"
   },
   {
    "tool": "alignment_station",
    "args": {
     "doc": "$s.doc",
     "stations": [
      0,
      100
     ]
    },
    "as": "a"
   },
   {
    "tool": "profile_sample",
    "args": {
     "doc": "$s.doc",
     "step": 100
    },
    "as": "pr"
   }
  ],
  "check": [
   {
    "file": "site.civilcraft.json",
    "kind": "json",
    "path": "alignments[name=Main street].name",
    "eq": "Main street"
   }
  ]
 },
