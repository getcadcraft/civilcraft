     "group": "CP"
    },
    "as": "p"
   }
  ],
  "check": [
   {
    "file": "site.civilcraft.json",
    "kind": "json",
    "path": "name",
    "eq": "Eval site"
   }
  ]
 },
 {
  "id": "import-csv",
  "title": "Open a survey CSV and save it as a site",
  "prompt": "Open site-topo.csv and save it as a CivilCraft site.",
  "fixtures": {
   "topo.csv": "tools/civilcraft-test/site-topo.csv"
  },
  "allow": [
   "read",
   "save"
  ],
  "steps": [
   {
    "tool": "site_open",
    "args": {
     "path": "topo.csv"
    },
    "as": "s"
   },
   {
    "tool": "site_save",
    "args": {
     "doc": "$s.doc",
     "path": "topo.civilcraft.json"
    }
   }
  ],
  "check": [
   {
    "file": "topo.civilcraft.json",
    "kind": "json",
    "path": "points.length",
    "eq": 276
   },
   {
    "file": "topo.civilcraft.json",
    "kind": "json",
    "path": "format",
    "exists": true
   }
  ]
 },
 {
  "id": "new-site-add-points",
  "title": "Start a site and add three points",
  "prompt": "Make a new metric site and add three survey points.",
  "fixtures": {},
  "allow": [
   "read",
   "edit",
   "save"
  ],
  "steps": [
   {
    "tool": "site_new",
    "args": {
     "name": "Plot",
     "units": "m"
    },
    "as": "n"
   },
   {
    "tool": "points_add",
    "args": {
     "doc": "$n.doc",
     "points": [
      {
       "n": "1",
       "x": 0,
       "y": 0,
       "z": 10
      },
      {
       "n": "2",
       "x": 10,
       "y": 0,
       "z": 11
      },
      {
       "n": "3",
       "x": 0,
       "y": 10,
       "z": 12
      }
     ]
    }
   },
   {
    "tool": "site_save",
    "args": {
     "doc": "$n.doc",
     "path": "plot.civilcraft.json"
    }
   }
  ],
  "check": [
   {
    "file": "plot.civilcraft.json",
    "kind": "json",
    "path": "points.length",
    "eq": 3
   },
   {
    "file": "plot.civilcraft.json",
    "kind": "json",
    "path": "units",
    "eq": "m"
   },
   {
    "file": "plot.civilcraft.json",
    "kind": "json",
    "path": "name",
    "eq": "Plot"
   }
  ]
 },
