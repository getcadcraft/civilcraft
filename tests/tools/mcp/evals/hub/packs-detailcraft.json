 },
 {
  "id": "detailcraft-steel.check-the-frame",
  "title": "Check the frame",
  "pack": "detailcraft-steel",
  "prompt": "Check the frame for clashes between members, ignoring overlaps under 2 mm, and for anything that cannot be built.",
  "allow": [
   "read",
   "edit"
  ],
  "setup": {},
  "steps": [
   {
    "tool": "member_add",
    "args": {
     "type": "column",
     "start": [
      0,
      0,
      0
     ],
     "end": [
      0,
      0,
      4000
     ],
     "profile": "W10x33"
    },
    "as": "c",
    "expect": [
     {
      "path": "mark",
      "eq": "c1"
     }
    ]
   },
   {
    "tool": "member_add",
    "args": {
     "type": "beam",
     "start": [
      0,
      0,
      4000
     ],
     "end": [
      6000,
      0,
      4000
     ]
    },
    "as": "b",
    "expect": [
     {
      "path": "mark",
      "eq": "b1"
     }
    ]
   },
   {
    "tool": "clash_check",
    "args": {
     "tolerance": 2
    },
    "expect": [
     {
      "path": "checked",
      "eq": 2
     },
     {
      "path": "total",
      "eq": 1
     }
    ]
   },
   {
    "tool": "constructability_check",
    "args": {},
    "expect": [
     {
      "path": "problems.length",
      "eq": 0
     }
    ]
   }
  ],
  "check": [
   {
    "tool": "app_info",
    "path": "members",
    "eq": 2
   }
  ]
 }
]
