    "tool": "markups_list",
    "path": "total",
    "eq": 0
   }
  ]
 },
 {
  "id": "export-csv",
  "title": "Export the markups as CSV",
  "prompt": "Export the markups to a CSV file.",
  "allow": [
   "read",
   "edit",
   "export"
  ],
  "setup": {
   "files": [
    {
     "fixture": "fixtures/pdf/kitchen-plan-sheet.pdf",
     "via": "window.markupcraft.openFiles",
     "type": "application/pdf"
    }
   ],
   "wait": "window.markupcraft && window.markupcraft.sheets.length === 1"
  },
  "steps": [
   {
    "tool": "markup_add",
    "args": {
     "type": "cloudrect",
     "rect": [
      0.1,
      0.1,
      0.4,
      0.3
     ],
     "comment": "Check this wall"
    },
    "as": "m"
   },
   {
    "tool": "markups_export",
    "args": {
     "format": "csv"
    },
    "download": {
     "name": "\\.csv$",
     "includes": [
      "Check this wall"
     ]
    }
   }
  ]
 }
]