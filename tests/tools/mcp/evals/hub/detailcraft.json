[
 {
  "id": "new-model",
  "title": "What a new model has",
  "prompt": "Look at the model before drawing anything.",
  "allow": [
   "read",
   "edit"
  ],
  "setup": {},
  "steps": [
   {
    "tool": "model_describe",
    "expect": [
     {
      "path": "units",
      "eq": "mm"
     },
     {
      "path": "grids.numbered.length",
      "eq": 3
     },
     {
      "path": "levels.length",
      "eq": 2
     },
     {
      "path": "members.length",
      "eq": 0
     }
    ]
   },
   {
    "tool": "app_info",
    "expect": [
     {
      "path": "members",
      "eq": 0
     },
     {
      "path": "steelKg",
      "eq": 0
     }
    ]
   }
  ]
 },
 {
  "id": "column-and-beam",
  "title": "A column and a beam",
  "prompt": "Draw a 4 m column and a 6 m beam on top of it.",
  "allow": [
   "read",
   "edit"
  ],
  "setup": {},
  "steps": [
   {
    "tool": "member_add",
    "args": {
     "type": "column",
     "start": [
      0,
      0,
      0
     ],
     "end": [
      0,
      0,
      4000
     ],
     "profile": "W10x33"
    },
    "as": "c",
    "expect": [
     {
      "path": "mark",
      "eq": "c1"
     }
    ]
   },
   {
    "tool": "member_add",
    "args": {
     "type": "beam",
     "start": [
      0,
      0,
      4000
     ],
     "end": [
      6000,
      0,
      4000
     ]
    },
    "as": "b",
    "expect": [
     {
      "path": "mark",
      "eq": "b1"
     }
    ]
   }
  ],
  "check": [
   {
    "tool": "parts_list",
    "path": "total",
    "eq": 2
   }
  ]
 },
 {
  "id": "steel-weight",
  "title": "Weigh a column",
  "prompt": "How much does a 4 m W10x33 column weigh?",
  "allow": [
   "read",
   "edit"
  ],
  "setup": {},
  "steps": [
   {
    "tool": "member_add",
    "args": {
     "type": "column",
     "start": [
      0,
      0,
      0
     ],
     "end": [
      0,
      0,
      4000
     ],
     "profile": "W10x33"
    },
    "as": "c",
    "expect": [
     {
      "path": "mark",
      "eq": "c1"
     }
    ]
   }
  ],
  "check": [
   {
    "tool": "parts_list",
    "path": "parts.0.weightEachKg",
    "approx": 196.4,
    "tol": 0.1
   }
  ]
 },
 {
  "id": "endplate",
  "title": "Connect the beam to the column",
  "prompt": "Connect the beam to the column with an end plate.",
  "allow": [
   "read",
   "edit"
  ],
  "setup": {},
  "steps": [
   {
    "tool": "member_add",
    "args": {
     "type": "column",
     "start": [
      0,
      0,
      0
     ],
     "end": [
      0,
      0,
      4000
     ],
     "profile": "W10x33"
    },
    "as": "c",
    "expect": [
     {
      "path": "mark",
      "eq": "c1"
     }
    ]
   },
   {
    "tool": "member_add",
    "args": {
     "type": "beam",
     "start": [
      0,
      0,
      4000
     ],
     "end": [
      6000,
      0,
      4000
     ]
    },
    "as": "b",
    "expect": [
     {
      "path": "mark",
      "eq": "b1"
     }
    ]
   },
   {
    "tool": "connection_add",
    "args": {
     "type": "endplate",
     "members": [
      "$c.id",
      "$b.id"
     ]
    },
    "expect": [
     {
      "path": "added.length",
      "eq": 1
     }
    ]
   }
  ],
  "check": [
   {
    "tool": "model_describe",
    "path": "connections.0.count",
    "eq": 1
   }
  ]
 },
 {
  "id": "autopilot-baseplates",
  "title": "Base plates by autopilot",
  "prompt": "Put base plates under the columns.",
  "allow": [
   "read",
   "edit"
  ],
  "setup": {},
  "steps": [
   {
    "tool": "member_add",
    "args": {
     "type": "column",
     "start": [
      0,
      0,
      0
     ],
     "end": [
      0,
      0,
      4000
     ],
     "profile": "W10x33"
    },
    "as": "c",
    "expect": [
     {
      "path": "mark",
      "eq": "c1"
     }
    ]
   },
   {
    "tool": "connection_autopilot",
    "args": {},
    "expect": [
     {
      "path": "counts.baseplate",
      "eq": 1
     }
    ]
   }
  ],
  "check": [
   {
    "tool": "model_describe",
    "path": "connections.0.type",
    "eq": "baseplate"
   }
  ]
 },
