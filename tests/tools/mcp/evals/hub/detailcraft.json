 {
  "id": "select-by-mark",
  "title": "Select a part by its mark",
  "prompt": "Select beam b1 and tell me what it is.",
  "allow": [
   "read",
   "edit"
  ],
  "setup": {},
  "steps": [
   {
    "tool": "member_add",
    "args": {
     "type": "column",
     "start": [
      0,
      0,
      0
     ],
     "end": [
      0,
      0,
      4000
     ],
     "profile": "W10x33"
    },
    "as": "c",
    "expect": [
     {
      "path": "mark",
      "eq": "c1"
     }
    ]
   },
   {
    "tool": "member_add",
    "args": {
     "type": "beam",
     "start": [
      0,
      0,
      4000
     ],
     "end": [
      6000,
      0,
      4000
     ]
    },
    "as": "b",
    "expect": [
     {
      "path": "mark",
      "eq": "b1"
     }
    ]
   },
   {
    "tool": "selection_set",
    "args": {
     "marks": [
      "b1"
     ]
    },
    "expect": [
     {
      "path": "selected",
      "eq": 1
     }
    ]
   },
   {
    "tool": "selection_get",
    "expect": [
     {
      "path": "selected.0.type",
      "eq": "beam"
     },
     {
      "path": "selected.0.mark",
      "eq": "b1"
     }
    ]
   }
  ]
 },
 {
  "id": "framing-wall",
  "title": "A stud wall",
  "prompt": "Add a 4 m by 2.4 m timber wall and give me its cut list.",
  "allow": [
   "read",
   "edit"
  ],
  "setup": {},
  "steps": [
   {
    "tool": "framing_panel_add",
    "args": {
     "kind": "wall",
     "length": 4000,
     "height": 2400
    },
    "expect": [
     {
      "path": "summary.pieces",
      "eq": 14
     }
    ]
   },
   {
    "tool": "framing_panels",
    "expect": [
     {
      "path": "panels.0.cutList.0.piece",
      "eq": "plate"
     },
     {
      "path": "panels.0.cutList.0.count",
      "eq": 3
     }
    ]
   }
  ]
 },
 {
  "id": "undo-two",
  "title": "Take two steps back",
  "prompt": "Draw a column, a beam and a connection, then undo the last two.",
  "allow": [
   "read",
   "edit"
  ],
  "setup": {},
  "steps": [
   {
    "tool": "member_add",
    "args": {
     "type": "column",
     "start": [
      0,
      0,
      0
     ],
     "end": [
      0,
      0,
      4000
     ],
     "profile": "W10x33"
    },
    "as": "c",
    "expect": [
     {
      "path": "mark",
      "eq": "c1"
     }
    ]
   },
   {
    "tool": "member_add",
    "args": {
     "type": "beam",
     "start": [
      0,
      0,
      4000
     ],
     "end": [
      6000,
      0,
      4000
     ]
    },
    "as": "b",
    "expect": [
     {
      "path": "mark",
      "eq": "b1"
     }
    ]
   },
   {
    "tool": "connection_add",
    "args": {
     "type": "endplate",
     "members": [
      "$c.id",
      "$b.id"
     ]
    }
   },
   {
    "tool": "undo",
    "args": {
     "steps": 2
    },
    "expect": [
     {
      "path": "undone.length",
      "eq": 2
     }
    ]
   }
  ],
  "check": [
   {
    "tool": "parts_list",
    "path": "total",
    "eq": 1
   }
  ]
 },
 {
  "id": "says-what-to-try",
  "title": "Errors say what is wrong",
  "prompt": "Try a beam with no length, then a connection with a made-up member.",
  "allow": [
   "read",
   "edit"
  ],
  "setup": {},
  "steps": [
   {
    "tool": "member_add",
    "args": {
     "type": "beam",
     "start": [
      0,
      0,
      0
     ],
     "end": [
      0,
      0,
      0
     ]
    },
    "fail": "same"
   },
   {
    "tool": "connection_add",
    "args": {
     "type": "endplate",
     "members": [
      1,
      2
     ]
    },
    "fail": "must be string"
   }
  ],
  "check": [
   {
    "tool": "app_info",
    "path": "members",
    "eq": 0
   }
  ]
 },
 {
