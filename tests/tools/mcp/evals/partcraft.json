[
 {
  "id": "describe-part",
  "title": "Describe the screw",
  "prompt": "Open the screw and tell me what it is made of and how many features it has.",
  "fixtures": {
   "Parts/screw.partcraft.json": "tools/mcp/evals/fixtures/screw.partcraft.json"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "part_open",
    "args": {
     "path": "Parts/screw.partcraft.json"
    },
    "as": "o"
   },
   {
    "tool": "part_describe",
    "args": {
     "doc": "$o.doc"
    },
    "as": "d"
   }
  ],
  "check": [
   {
    "file": "Parts/screw.partcraft.json",
    "kind": "json",
    "path": "name",
    "eq": "Hex head screw ISO 4017"
   },
   {
    "file": "Parts/screw.partcraft.json",
    "kind": "json",
    "path": "features.length",
    "eq": 4
   },
   {
    "file": "Parts/screw.partcraft.json",
    "kind": "json",
    "path": "material.name",
    "eq": "Steel"
   }
  ]
 },
