 {
  "id": "design-bracket",
  "title": "Bracket holding 20 pounds at 6 inches, aluminium, machinable",
  "headliner": true,
  "prompt": "I need a bracket holding 20 pounds at 6 inches, aluminium, machinable. Pick a generator, size it, check it and give me the part.",
  "folders": [
   "Out"
  ],
  "fixtures": {},
  "allow": [
   "read",
   "save"
  ],
  "steps": [
   {
    "tool": "generators_find",
    "args": {
     "text": "bracket holding 20 pounds at 6 inches, aluminium, machinable"
    },
    "as": "g",
    "expect": [
     {
      "path": "picks[id=bracket].score",
      "gte": 3
     }
    ]
   },
   {
    "tool": "design_estimate",
    "args": {
     "generator": "bracket",
     "force": 20,
     "force_unit": "lbf",
     "arm": 6,
     "length_unit": "in",
     "material": "aluminium",
     "process": "machined"
    },
    "as": "e",
    "expect": [
     {
      "path": "ok",
      "eq": true
     },
     {
      "path": "dims.thickness_mm",
      "eq": 5
     },
     {
      "path": "dims.bolt",
      "eq": "M5"
     }
    ]
   },
   {
    "tool": "design_make",
    "args": {
     "generator": "bracket",
     "force": 20,
     "force_unit": "lbf",
     "arm": 6,
     "length_unit": "in",
     "material": "aluminium",
     "process": "machined",
     "name": "Shelf bracket",
     "out": "Out/bracket.partcraft.json"
    }
   }
  ],
  "check": [
   {
    "file": "Out/bracket.partcraft.json",
    "kind": "part",
    "path": "bodies",
    "eq": 1
   },
   {
    "file": "Out/bracket.partcraft.json",
    "kind": "part",
    "path": "failing.length",
    "eq": 0
   },
   {
    "file": "Out/bracket.partcraft.json",
    "kind": "part",
    "path": "mass",
    "approx": 81.7,
    "tol": 1.0
   },
   {
    "file": "Out/bracket.partcraft.json",
    "kind": "part",
    "path": "stressPerN",
    "lte": 1.5512
   },
   {
    "file": "Out/bracket.partcraft.json",
    "kind": "part",
    "path": "thickness",
    "gte": 3.86
   },
   {
    "file": "Out/bracket.partcraft.json",
    "kind": "json",
    "path": "material.name",
    "eq": "aluminium 6061-T6"
   }
  ]
 },
 {
  "id": "cost-estimate",
  "title": "What would it cost to make the bracket",
  "prompt": "What would it cost to make 10 of this bracket, machined?",
  "fixtures": {
   "Parts/bracket.partcraft.json": "fixtures/showcase/partcraft-bracket-20lb.partcraft.json"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "part_open",
    "args": {
     "path": "Parts/bracket.partcraft.json"
    },
    "as": "o"
   },
   {
    "tool": "cost_estimate",
    "args": {
     "doc": "$o.doc",
     "process": "cnc",
     "qty": 10
    },
    "as": "c",
    "expect": [
     {
      "path": "process",
      "eq": "cnc"
     },
     {
      "path": "qty",
      "eq": 10
     },
     {
      "path": "rows[id=holes].basis.holes",
      "eq": 2
     },
     {
      "path": "total",
      "approx": 91.31,
      "tol": 0.05
     },
     {
      "path": "rows[id=setup].amount",
      "eq": 6
     }
    ]
   }
  ],
  "check": [
   {
    "file": "Parts/bracket.partcraft.json",
    "kind": "part",
    "path": "bodies",
    "eq": 1
   }
  ]
 },
 {
  "id": "photo-to-sketch",
  "title": "Sketch a plate from a photo",
  "prompt": "Here is a photo of a plate, 100 mm wide. Make it a part, 10 mm thick, and save it.",
  "folders": [
   "Out"
  ],
  "fixtures": {
   "Parts/blank.partcraft.json": "tools/mcp/evals/fixtures/blank.partcraft.json",
   "Photos/plate.png": "tools/mcp/evals/fixtures/plate-photo.png"
  },
  "allow": [
   "read",
   "edit",
   "save"
  ],
  "steps": [
   {
    "tool": "part_open",
    "args": {
     "path": "Parts/blank.partcraft.json"
    },
    "as": "o"
   },
   {
    "tool": "photo_import",
    "args": {
     "doc": "$o.doc",
     "path": "Photos/plate.png",
     "known_of": "width",
     "known_mm": 100,
     "extrude": 10
    },
    "as": "p",
    "expect": [
     {
      "path": "entities.lines",
      "eq": 4
     },
     {
      "path": "entities.arcs",
      "eq": 4
     },
     {
      "path": "entities.circles",
      "eq": 1
     },
     {
      "path": "size_mm.width",
      "approx": 100,
      "tol": 0.3
     }
    ]
   },
   {
    "tool": "part_save",
    "args": {
     "doc": "$o.doc",
     "path": "Out/plate.partcraft.json"
    }
   }
  ],
  "check": [
   {
    "file": "Out/plate.partcraft.json",
    "kind": "part",
    "path": "bodies",
    "eq": 1
   },
   {
    "file": "Out/plate.partcraft.json",
    "kind": "part",
    "path": "failing.length",
    "eq": 0
   },
   {
    "file": "Out/plate.partcraft.json",
    "kind": "part",
    "path": "volume",
    "approx": 58876,
    "tol": 600
   },
   {
    "file": "Out/plate.partcraft.json",
    "kind": "json",
    "path": "features.length",
    "eq": 2
   }
  ]
 },
 {
  "id": "hydrostatics-barge",
  "title": "Will this barge float upright at 1 m draft",
  "prompt": "This 10 \u00d7 3 \u00d7 4 m barge floats in the sea at 1 m draft with its centre of gravity 1.2 m above the keel. What does it displace, and is it stable?",
  "fixtures": {
   "Parts/barge.partcraft.json": "tools/mcp/evals/fixtures/barge.partcraft.json"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "part_open",
    "args": {
     "path": "Parts/barge.partcraft.json"
    },
    "as": "o"
   },
   {
    "tool": "hydrostatics_describe",
    "args": {
     "doc": "$o.doc",
     "draft": 1,
     "length_unit": "m",
     "water": "sea",
     "kg": 1.2,
     "heel_to": 20
    },
    "as": "h",
    "expect": [
     {
      "path": "displacement_t",
      "approx": 41,
      "tol": 0.01
     },
     {
      "path": "kb_m",
      "approx": 0.5,
      "tol": 0.001
     },
     {
      "path": "bm_transverse_m",
      "approx": 1.3333,
      "tol": 0.001
     },
     {
      "path": "stability.gm_m",
      "approx": 0.6333,
      "tol": 0.001
     },
     {
      "path": "stability.stable_upright",
      "eq": true
     },
     {
      "path": "stability.righting_arms[heel_deg=10].gz_m",
      "approx": 0.1136,
      "tol": 0.002
     }
    ]
   }
  ],
  "check": [
   {
    "file": "Parts/barge.partcraft.json",
    "kind": "part",
    "path": "bodies",
    "eq": 1
   }
  ]
 }
]