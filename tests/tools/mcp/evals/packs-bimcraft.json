[
 {
  "id": "bimcraft-residential.describe-house",
  "title": "Describe the house",
  "pack": "bimcraft-residential",
  "prompt": "What levels, walls, doors and windows does house.ifc have?",
  "fixtures": {
   "house.ifc": "fixtures/showcase/bimcraft-house.ifc"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "ifc_open",
    "args": {
     "path": "house.ifc"
    },
    "as": "o"
   },
   {
    "tool": "model_describe",
    "args": {
     "doc": "$o.doc"
    }
   }
  ],
  "check": [
   {
    "file": "house.ifc",
    "kind": "ifc",
    "path": "classes.IFCWALL",
    "eq": 13
   },
   {
    "file": "house.ifc",
    "kind": "ifc",
    "path": "classes.IFCDOOR",
    "eq": 7
   }
  ]
 },
 {
  "id": "bimcraft-residential.list-doors",
  "title": "List the doors",
  "pack": "bimcraft-residential",
  "prompt": "List every door in house.ifc.",
  "fixtures": {
   "house.ifc": "fixtures/showcase/bimcraft-house.ifc"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "ifc_open",
    "args": {
     "path": "house.ifc"
    },
    "as": "o"
   },
   {
    "tool": "ifc_query",
    "args": {
     "doc": "$o.doc",
     "class": "IfcDoor",
     "limit": 50
    },
    "as": "q"
   }
  ],
  "check": [
   {
    "file": "house.ifc",
    "kind": "ifc",
    "path": "classes.IFCDOOR",
    "eq": 7
   },
   {
    "file": "house.ifc",
    "kind": "ifc",
    "path": "classes.IFCWINDOW",
    "eq": 9
   }
  ]
 },
