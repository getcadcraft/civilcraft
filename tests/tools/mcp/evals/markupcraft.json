[
 {
  "id": "list-all",
  "title": "List every markup",
  "prompt": "List all the markups in the marked-up set.",
  "fixtures": {
   "Set/marked.pdf": "tools/mcp/evals/fixtures/marked.pdf"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "markups_list",
    "args": {
     "path": "Set/marked.pdf"
    },
    "as": "l",
    "expect": [
     {
      "path": "total",
      "eq": 4
     }
    ]
   }
  ],
  "check": [
   {
    "file": "Set/marked.pdf",
    "kind": "pdf",
    "path": "pages",
    "gte": 1
   }
  ]
 },
 {
  "id": "list-open",
  "title": "Only the open ones",
  "prompt": "Show me only the markups still Open.",
  "fixtures": {
   "Set/marked.pdf": "tools/mcp/evals/fixtures/marked.pdf"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "markups_list",
    "args": {
     "path": "Set/marked.pdf",
     "status": "Open"
    },
    "as": "l",
    "expect": [
     {
      "path": "total",
      "eq": 2
     }
    ]
   }
  ],
  "check": [
   {
    "file": "Set/marked.pdf",
    "kind": "pdf",
    "path": "head",
    "matches": "^%PDF"
   }
  ]
 },
 {
  "id": "list-by-author",
  "title": "By author",
  "prompt": "What did Ana mark?",
  "fixtures": {
   "Set/marked.pdf": "tools/mcp/evals/fixtures/marked.pdf"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "markups_list",
    "args": {
     "path": "Set/marked.pdf",
     "author": "Ana"
    },
    "as": "l"
   }
  ],
  "check": [
   {
    "file": "Set/marked.pdf",
    "kind": "pdf",
    "path": "head",
    "matches": "^%PDF"
   }
  ]
 },
 {
  "id": "list-by-type",
  "title": "By type",
  "prompt": "List the cloud markups.",
  "fixtures": {
   "Set/marked.pdf": "tools/mcp/evals/fixtures/marked.pdf"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "markups_list",
    "args": {
     "path": "Set/marked.pdf",
     "type": "cloudrect"
    },
    "as": "l"
   }
  ],
  "check": [
   {
    "file": "Set/marked.pdf",
    "kind": "pdf",
    "path": "head",
    "matches": "^%PDF"
   }
  ]
 },
 {
  "id": "paging",
  "title": "Paging",
  "prompt": "Give me the markups two at a time.",
  "fixtures": {
   "Set/marked.pdf": "tools/mcp/evals/fixtures/marked.pdf"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "markups_list",
    "args": {
     "path": "Set/marked.pdf",
     "limit": 2
    },
    "as": "l"
   },
   {
    "tool": "markups_list",
    "args": {
     "path": "Set/marked.pdf",
     "limit": 2,
     "offset": 2
    },
    "as": "l"
   }
  ],
  "check": [
   {
    "file": "Set/marked.pdf",
    "kind": "pdf",
    "path": "head",
    "matches": "^%PDF"
   }
  ]
 },
 {
  "id": "unmarked-pdf",
  "title": "A PDF with no markups",
  "prompt": "List the markups on a clean plan sheet.",
  "fixtures": {
   "Set/clean.pdf": "fixtures/pdf/kitchen-plan-sheet.pdf"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "markups_list",
    "args": {
     "path": "Set/clean.pdf"
    },
    "expect": [
     {
      "path": "total",
      "eq": 0
     }
    ]
   }
  ],
  "check": [
   {
    "file": "Set/clean.pdf",
    "kind": "pdf",
    "path": "head",
    "matches": "^%PDF"
   }
  ]
 },
 {
  "id": "outside-folder-refused",
  "title": "A file outside the granted folder is refused",
  "prompt": "List markups of /etc/passwd.",
  "fixtures": {
   "Set/marked.pdf": "tools/mcp/evals/fixtures/marked.pdf"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "markups_list",
    "args": {
     "path": "/etc/passwd"
    },
    "fail": "outside"
   }
  ],
  "check": [
   {
    "file": "Set/marked.pdf",
    "kind": "pdf",
    "path": "head",
    "matches": "^%PDF"
   }
  ]
 },
 {
  "id": "not-a-pdf-refused",
  "title": "A file that is not a PDF is refused",
  "prompt": "List markups of a text file.",
  "fixtures": {
   "Set/a.pdf": "tools/mcp/evals/fixtures/screw.partcraft.json"
  },
  "allow": [
   "read"
  ],
  "steps": [
   {
    "tool": "markups_list",
    "args": {
     "path": "Set/a.pdf"
    },
    "fail": "could not be read as a PDF"
   }
  ],
  "check": [
   {
    "file": "Set/a.pdf",
    "kind": "bytes",
    "path": "size",
    "gte": 1
   }
  ]
 }
]